---
interface Props {
  title?: string;
}

const { title = 'Joblo Web — Websites that work.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a href="/" class="brand">Joblo Web</a>
        <nav>
          <a href="#services">Services</a>
          <a href="#work">Work</a>
          <a href="#contact" class="btn-primary">Get a Quote</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container footer-inner">
        <div>
          <strong>Joblo Web</strong>
          <p>Websites that work.</p>
        </div>
        <div>
          <p>© {new Date().getFullYear()} Joblo Web.</p>
        </div>
      </div>
    </footer>

    <style is:global>
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background-color: #0a0a0f;
        background-image: radial-gradient(circle at 50% 0%, #1a1a2e 0%, #0a0a0f 70%);
        color: #eaeaf2;
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.6;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main { flex: 1; }
      .nav {
        position: sticky; top: 0; z-index: 100;
        background: rgba(10, 10, 15, 0.8); backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }
      .nav-inner {
        max-width: 1100px; margin: 0 auto; padding: 1.25rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center;
      }
      .brand {
        font-weight: 800; font-size: 1.25rem; text-decoration: none;
        background: linear-gradient(90deg, #ffd93d, #ff8a3d);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }
      nav { display: flex; align-items: center; gap: 2rem; }
      nav a:not(.btn-primary) {
        text-decoration: none; font-size: 0.95rem; color: #a0a0b0;
        font-weight: 500; transition: color 0.2s;
      }
      nav a:not(.btn-primary):hover { color: #fff; }
      .btn-primary {
        background: linear-gradient(135deg, #ffd93d, #ff8a3d);
        color: #0a0a0f !important; padding: 0.6rem 1.2rem; border-radius: 8px;
        font-weight: 700; text-decoration: none; transition: transform 0.2s;
      }
      .btn-primary:hover { transform: translateY(-2px); }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; width: 100%; }
      .section { padding: 6rem 0; }
      .section-title { font-size: 2.5rem; font-weight: 800; margin: 0 0 1rem 0; }
      .section-subtitle { font-size: 1.1rem; color: #a0a0b0; margin: 0 0 3rem 0; }
      footer { border-top: 1px solid rgba(255, 255, 255, 0.05); padding: 3rem 0; margin-top: 4rem; }
      .footer-inner { display: flex; justify-content: space-between; color: #a0a0b0; font-size: 0.9rem; }
    </style>
  </body>
</html>
